@model SistemaFarmacia.Models.Estante

<h2>Eliminar Estante</h2>

<div class="alert alert-danger">
    ¿Estás seguro de eliminar este estante?
</div>

<form method="post">

    <input type="hidden" asp-for="Id" />

    <p><strong>Nombre:</strong> @Model.Nombre</p>
    <p><strong>Ubicación:</strong> @Model.Ubicacion</p>
    <p><strong>Descripción:</strong> @Model.Descripcion</p>

    <button class="btn btn-danger">Eliminar</button>
    <a href="/Estante/Index" class="btn btn-secondary">Cancelar</a>

</form>