﻿@using Microsoft.AspNetCore.Identity
@using SistemaFarmacia.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Farmacia</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">

            <a class="navbar-brand" href="/">💊 Farmacia</a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <!-- MENU IZQUIERDO -->
                <ul class="navbar-nav me-auto">

                    @if (SignInManager.IsSignedIn(User))
                    {

                        <!-- ADMINISTRADOR -->
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Index">Panel Admin</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Usuarios">Usuarios</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Categoria/Index">Categorías</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Estante/Index">Estantes</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Medicamento/Index">Medicamentos</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Dashboard/Index">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white" href="/Auditoria">Auditoría</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Bitacora">Bitácora</a>
                            </li>
                        }

                        <!-- FARMACEUTICO -->
                        @if (User.IsInRole("Farmaceutico"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Medicamento/Index">Medicamentos</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Categoria/Index">Categorías</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Estante/Index">Estantes</a>
                            </li>
                        }

                        <!-- CLIENTE -->
                        @if (User.IsInRole("Cliente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Catalogo">Catálogo</a>
                            </li>
                        }

                        <!-- CLAIM REPORTES -->
                        @if (User.HasClaim("PermisoReportes", "true"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Reportes">Reportes</a>
                            </li>
                        }

                    }

                </ul>

                <!-- MENU DERECHO LOGIN -->
                <ul class="navbar-nav">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var user = await UserManager.GetUserAsync(User);

                        <li class="nav-item">
                            <span class="nav-link text-light">
                                👋 Hola, @user.Nombre
                            </span>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Auth"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                <button class="btn btn-danger ms-2">
                                    Cerrar sesión
                                </button>

                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-light me-2"
                                   href="/Auth/Login">
                                Iniciar sesión
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-warning"
                                   href="/Auth/Register">
                                Registrarse
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
