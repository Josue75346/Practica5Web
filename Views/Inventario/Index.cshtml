@{
    ViewData["Title"] = "Inventario Inteligente";
}

<h2 class="text-primary mb-4">Inventario Inteligente</h2>

<!-- MEDICAMENTOS VENCIDOS -->
<h3 class="text-danger">⚠ Medicamentos Vencidos</h3>
@if (((List<SistemaFarmacia.Models.Medicamento>)ViewBag.Vencidos).Count == 0)
{
    <p class="text-muted">No hay medicamentos vencidos.</p>
}
else
{
    <table class="table table-bordered table-danger">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Estante</th>
                <th>Fecha Vencimiento</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in ViewBag.Vencidos)
            {
                <tr>
                    <td>@m.Nombre</td>
                    <td>@m.Categoria.Nombre</td>
                    <td>@m.Estante.Nombre</td>
                    <td>@m.FechaVencimiento.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

