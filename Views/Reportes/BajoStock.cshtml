@model IEnumerable<SistemaFarmacia.Models.Medicamento>

<a href="/Reportes/BajoStockPdf" class="btn btn-info mb-3">Exportar PDF</a>

<h2>Medicamentos con Bajo Stock (menos de 10)</h2>
<hr />

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Stock</th>
            <th>Precio</th>
            <th>Fecha Vencimiento</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr class="table-warning">
                <td>@m.Nombre</td>
                <td>@m.Categoria.Nombre</td>
                <td><b>@m.Stock</b></td>
                <td>@m.Precio</td>
                <td>@m.FechaVencimiento.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>