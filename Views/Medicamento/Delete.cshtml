@model SistemaFarmacia.Models.Medicamento

<h2>Eliminar Medicamento</h2>

<h4>¿Seguro que deseas eliminar este medicamento?</h4>

<div class="card p-3">

    <p><strong>Nombre:</strong> @Model.Nombre</p>
    <p><strong>Descripción:</strong> @Model.Descripcion</p>
    <p><strong>Precio:</strong> @Model.Precio</p>
    <p><strong>Stock:</strong> @Model.Stock</p>
    <p><strong>Categoría:</strong> @Model.Categoria?.Nombre</p>
    <p><strong>Estante:</strong> @Model.Estante?.Nombre</p>

</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger mt-3">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancelar</a>
</form>